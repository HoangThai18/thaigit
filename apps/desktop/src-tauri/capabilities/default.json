{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quyền của cửa sổ chính: chỉ lệnh của chính app + nghe sự kiện. Không shell:*, không fs:*, không dialog:*, không opener:*.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-pick-repo-folder",
    "allow-open-repo",
    "allow-trust-repo",
    "allow-list-recent-repos",
    "allow-forget-recent-repo",
    "allow-take-launch-paths",
    "allow-git-exec",
    "allow-git-cancel",
    "allow-git-clone",
    "allow-git-init",
    "allow-git-config-set",
    "allow-git-remote-add",
    "allow-git-remote-set-url",
    "allow-repo-health",
    "allow-remove-stale-lock",
    "allow-fs-read-git-file",
    "allow-fs-read-worktree-file",
    "allow-fs-write-worktree-file",
    "allow-fs-append-gitignore",
    "allow-fs-trash-untracked",
    "allow-fs-restore-trash",
    "allow-watch-repo",
    "allow-unwatch-repo",
    "allow-git-locate",
    "allow-set-git-path",
    "allow-pick-git-path",
    "allow-open-in-terminal",
    "allow-open-in-editor",
    "allow-reveal",
    "allow-open-url",
    "allow-session-reset"
  ]
}
