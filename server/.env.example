# Cấu hình máy chủ Thaigit (API AI + thống kê). Chép thành /etc/thaigit-api.env (chmod 600, chủ sở hữu root).
# Mọi giá trị có mặc định trừ 3 secret. Tạo secret: openssl rand -hex 32  (ba giá trị KHÁC NHAU).

AI_ID_SECRET=
AI_TOKEN_SECRET=
TELEMETRY_ID_SECRET=
# Hoặc đọc secret từ file (Docker secrets): AI_ID_SECRET_FILE=/run/secrets/ai_id_secret …

# Nơi nghe. Đứng sau Caddy/nginx trên cùng máy → giữ 127.0.0.1.
HOST=127.0.0.1
PORT=8787
# Trang admin chỉ-đọc — KHÔNG mở ra Internet; xem bằng: ssh -L 8788:127.0.0.1:8788 <vps>
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
DATA_DIR=/var/lib/thaigit-api

# Reverse proxy được tin để đọc X-Real-IP (IP hoặc CIDR, cách nhau bằng dấu phẩy).
TRUSTED_PROXY=127.0.0.1,::1

# Hermes: bất kỳ máy chủ kiểu OpenAI (/v1/chat/completions + SSE) — Ollama, llama.cpp server, vLLM…
# Chỉ để nó nghe 127.0.0.1 (hoặc mạng riêng); tường lửa chặn cổng này từ Internet.
HERMES_BASE_URL=http://127.0.0.1:11434/v1
HERMES_MODEL=hermes3
# HERMES_API_KEY=            # nếu máy chủ model đòi khoá
HERMES_TIMEOUT_S=120

# Trần năng lực — chỉnh theo sức máy (CPU/GPU/RAM).
AI_MAX_CONCURRENCY=2          # số câu trả lời sinh song song (khớp OLLAMA_NUM_PARALLEL)
AI_QUEUE_MAX=20               # số request được xếp hàng; đầy → "AI đang bận"
AI_QUEUE_TIMEOUT_S=60
AI_GLOBAL_RPM=60              # tổng request/phút
AI_IP_RPM=10                  # request/phút/IP
AI_MAX_INPUT_TOKENS=6000      # context của model phải ≥ số này + AI_MAX_TOKENS_*
AI_QUOTA_COMMIT=30            # lượt/ngày/máy (ngày theo giờ Việt Nam)
AI_QUOTA_EXPLAIN=20
AI_QUOTA_PR=10
# Tắt AI tức thì: touch /var/lib/thaigit-api/ai-disabled   (xoá file để bật lại)
# AI_KILL_SWITCH_FILE=/var/lib/thaigit-api/ai-disabled
