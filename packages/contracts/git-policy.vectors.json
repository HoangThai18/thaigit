{
  "$comment": "Ca kiểm thử dùng chung cho validator TS (src/policy.ts) và Rust (policy.rs): kết quả phải giống hệt. `reject` là mã vi phạm mong đợi, null = được phép.",
  "cases": [
    {
      "sub": "status",
      "args": ["--porcelain=v2", "-z", "--branch", "--untracked-files=all"],
      "reject": null
    },
    { "sub": "status", "args": ["-uno"], "reject": null },
    { "sub": "log", "args": ["--format=%H%x1f%P", "-z", "--date-order", "-n2000", "--all"], "reject": null },
    { "sub": "log", "args": ["-p", "-M", "--", "src/app.ts"], "reject": null },
    { "sub": "diff", "args": ["--cached", "-M", "-U3", "--", "a.txt"], "reject": null },
    { "sub": "diff", "args": ["-C", "--stat"], "reject": null },
    { "sub": "show", "args": ["-s", "--format=%B", "abc123", "--"], "reject": null },
    { "sub": "commit", "args": ["-F", "-", "--cleanup=strip"], "reject": null },
    { "sub": "commit", "args": ["--amend", "-C", "HEAD"], "reject": null },
    { "sub": "cherry-pick", "args": ["-x", "abc123"], "reject": null },
    { "sub": "push", "args": ["-u", "origin", "feature/x"], "reject": null },
    { "sub": "push", "args": ["--force-with-lease", "origin", "main"], "reject": null },
    { "sub": "fetch", "args": ["--all", "--prune", "--progress"], "reject": null },
    { "sub": "fetch", "args": ["https://github.com/HoangThai18/thaigit.git", "main"], "reject": null },
    { "sub": "switch", "args": ["-c", "feature/moi", "--track", "origin/feature/moi"], "reject": null },
    { "sub": "stash", "args": ["push", "-u", "--message=Đang làm dở"], "reject": null },
    { "sub": "add", "args": ["--pathspec-from-file=-", "--pathspec-file-nul"], "reject": null },
    { "sub": "apply", "args": ["--cached", "--unidiff-zero", "-"], "reject": null },
    { "sub": "rev-parse", "args": ["--git-dir", "--git-common-dir", "--show-toplevel"], "reject": null },
    { "sub": "config", "args": ["--get", "user.name"], "reject": null },
    { "sub": "remote", "args": ["-v"], "reject": null },
    { "sub": "remote", "args": [], "reject": null },
    { "sub": "branch", "args": ["-u", "origin/main", "main"], "reject": null },
    { "sub": "rm", "args": ["--cached", "--", "-c weird name.txt"], "reject": null },

    { "sub": "submodule", "args": ["update"], "reject": "sub-not-allowed" },
    { "sub": "difftool", "args": [], "reject": "sub-not-allowed" },
    { "sub": "clone", "args": ["https://example.com/x.git"], "reject": "sub-not-allowed" },
    { "sub": "init", "args": [], "reject": "sub-not-allowed" },
    { "sub": "status", "args": ["-c", "core.fsmonitor=touch /tmp/pwned"], "reject": "flag-rejected" },
    { "sub": "status", "args": ["-ccore.fsmonitor=touch /tmp/pwned"], "reject": "flag-rejected" },
    { "sub": "log", "args": ["--config=core.pager=sh"], "reject": "flag-rejected" },
    { "sub": "fetch", "args": ["--upload-pack=touch /tmp/pwned", "origin"], "reject": "flag-rejected" },
    { "sub": "fetch", "args": ["--upl=touch /tmp/pwned", "origin"], "reject": "flag-rejected" },
    { "sub": "fetch", "args": ["-u", "touch /tmp/pwned", "origin"], "reject": "flag-rejected" },
    { "sub": "fetch", "args": ["-utouch /tmp/pwned", "origin"], "reject": "flag-rejected" },
    { "sub": "fetch", "args": ["-qu", "touch /tmp/pwned"], "reject": "attached-short" },
    { "sub": "push", "args": ["--receive-pack=sh", "origin"], "reject": "flag-rejected" },
    { "sub": "push", "args": ["--exec=sh", "origin"], "reject": "flag-rejected" },
    { "sub": "pull", "args": ["ext::sh -c touch% /tmp/pwned", "main"], "reject": "url-rejected" },
    { "sub": "fetch", "args": ["FD::17", "main"], "reject": "url-rejected" },
    { "sub": "ls-remote", "args": ["--", "ext::sh -c id"], "reject": "url-rejected" },
    { "sub": "rebase", "args": ["-x", "touch /tmp/pwned", "main"], "reject": "flag-rejected" },
    { "sub": "rebase", "args": ["--exec=touch /tmp/pwned", "main"], "reject": "flag-rejected" },
    { "sub": "diff", "args": ["--output=/tmp/overwrite"], "reject": "flag-rejected" },
    { "sub": "diff", "args": ["-o", "/tmp/overwrite"], "reject": "flag-rejected" },
    { "sub": "diff", "args": ["--ext-diff"], "reject": "flag-rejected" },
    { "sub": "log", "args": ["--textconv", "-p"], "reject": "flag-rejected" },
    { "sub": "commit", "args": ["--template=/etc/passwd"], "reject": "flag-rejected" },
    { "sub": "status", "args": ["--git-dir=/tmp/evil"], "reject": "flag-rejected" },
    { "sub": "status", "args": ["--work-tree=/"], "reject": "flag-rejected" },
    { "sub": "bisect", "args": ["run", "sh", "-c", "id"], "reject": "second-not-allowed" },
    { "sub": "remote", "args": ["add", "evil", "ext::sh -c id"], "reject": "typed-only" },
    { "sub": "remote", "args": ["set-url", "origin", "https://example.com"], "reject": "typed-only" },
    { "sub": "config", "args": ["core.fsmonitor", "touch /tmp/pwned"], "reject": "config-write" },
    { "sub": "config", "args": ["--get", "--unset", "core.fsmonitor"], "reject": "flag-rejected" },
    { "sub": "config", "args": ["--list", "--file=/etc/passwd"], "reject": "flag-rejected" },
    { "sub": "status", "args": [], "env": { "GIT_SSH_COMMAND": "sh -c id" }, "reject": "env-rejected" },
    { "sub": "status", "args": [], "env": { "GIT_OPTIONAL_LOCKS": "1" }, "reject": "env-rejected" },
    {
      "sub": "status",
      "args": [],
      "env": { "GIT_OPTIONAL_LOCKS": "0", "GIT_LITERAL_PATHSPECS": "1" },
      "reject": null
    }
  ]
}
