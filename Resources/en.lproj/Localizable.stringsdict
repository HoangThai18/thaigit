	</dict>
	<key>Viết lại %lld commit sau %@. Commit mới ở trên, cũ ở dưới; “Gộp” là gộp vào commit ngay bên dưới.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Rewrite %1$lld commit after %2$@. Newer commits are on top, older below; “Squash” merges into the commit right below.</string>
			<key>other</key>
			<string>Rewrite %1$lld commits after %2$@. Newer commits are on top, older below; “Squash” merges into the commit right below.</string>
		</dict>
	</dict>
