		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Restore %lld file to this snapshot?</string>
			<key>other</key>
			<string>Restore %lld files to this snapshot?</string>
		</dict>
	</dict>
