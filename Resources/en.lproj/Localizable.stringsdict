		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file changed</string>
			<key>other</key>
			<string>%lld files changed</string>
		</dict>
	</dict>
	<key>%lld lệnh gần nhất</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Last %lld command</string>
			<key>other</key>
			<string>Last %lld commands</string>
		</dict>
	</dict>
	<key>%lld đoạn xung đột</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld conflict</string>
			<key>other</key>
			<string>%lld conflicts</string>
		</dict>
	</dict>
	<key>%lld%@ commit có ở “Tới” mà “Từ” chưa có</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld%2$@ commit in “To” that “From” doesn't have</string>
			<key>other</key>
			<string>%1$lld%2$@ commits in “To” that “From” doesn't have</string>
		</dict>
	</dict>
	<key>%lld%@ commit sẽ vào %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld%2$@ commit will go into %3$@</string>
			<key>other</key>
			<string>%1$lld%2$@ commits will go into %3$@</string>
		</dict>
	</dict>
	<key>Chỉ hiện %lld nhánh (và nhánh đang checkout)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Showing only %lld branch (and the checked-out branch)</string>
			<key>other</key>
			<string>Showing only %lld branches (and the checked-out branch)</string>
		</dict>
	</dict>
	<key>Commit %lld file vào %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Commit %1$lld File to %2$@</string>
			<key>other</key>
			<string>Commit %1$lld Files to %2$@</string>
		</dict>
	</dict>
	<key>Còn %lld file xung đột chưa giải quyết</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
