			<string>%lld conflicted files still unresolved</string>
		</dict>
	</dict>
	<key>Còn %lld file xung đột — bấm vào từng file ở panel bên phải để chọn bản giữ lại.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld conflicted file left — click it in the right panel to choose what to keep.</string>
			<key>other</key>
			<string>%lld conflicted files left — click each in the right panel to choose what to keep.</string>
		</dict>
	</dict>
	<key>Giữ mốc trong %lld ngày</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
