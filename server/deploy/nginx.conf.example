# Thêm vào server { … } của git.thaipro.store (nginx), cạnh phần trang tĩnh sẵn có.
# API dùng chung tên miền: https://git.thaipro.store/v1/…, /download/mac, /download/win, /healthz

# Giới hạn riêng cho đăng ký cài đặt AI (đặt ở khối http { }):
#   limit_req_zone $binary_remote_addr zone=thaigit_install:10m rate=5r/h;

location = /v1/ai/install {
    limit_req zone=thaigit_install burst=3 nodelay;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    access_log off;
}

location ~ ^/(v1/|download/|healthz$) {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Ghi đè (không nối) — API chỉ tin header này khi đến từ 127.0.0.1.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    # SSE: không đệm, không cache, cho phép model trả lời chậm.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    client_max_body_size 256k;
    # Log truy cập chứa IP — tắt cho API.
    access_log off;
}

# Nên có ở khối server HTTPS: add_header Strict-Transport-Security "max-age=31536000" always;
