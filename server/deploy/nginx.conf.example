# Thêm vào server { … } của git.thaipro.store (nginx), cạnh phần trang tĩnh sẵn có.
# API dùng chung tên miền: https://git.thaipro.store/v1/…, /download/mac, /download/win, /healthz

# Tên miền đi qua Cloudflare: lấy IP thật từ CF-Connecting-IP, chỉ khi request đến từ dải IP của Cloudflare
# (https://www.cloudflare.com/ips/). Đặt ở khối http { } — sau đó $remote_addr / $binary_remote_addr là IP thật:
#   set_real_ip_from 173.245.48.0/20;
#   set_real_ip_from 103.21.244.0/22;
#   set_real_ip_from 103.22.200.0/22;
#   set_real_ip_from 103.31.4.0/22;
#   set_real_ip_from 141.101.64.0/18;
#   set_real_ip_from 108.162.192.0/18;
#   set_real_ip_from 190.93.240.0/20;
#   set_real_ip_from 188.114.96.0/20;
#   set_real_ip_from 197.234.240.0/22;
#   set_real_ip_from 198.41.128.0/17;
#   set_real_ip_from 162.158.0.0/15;
#   set_real_ip_from 104.16.0.0/13;
#   set_real_ip_from 104.24.0.0/14;
#   set_real_ip_from 172.64.0.0/13;
#   set_real_ip_from 131.0.72.0/22;
#   set_real_ip_from 2400:cb00::/32;
#   set_real_ip_from 2606:4700::/32;
#   set_real_ip_from 2803:f800::/32;
#   set_real_ip_from 2405:b500::/32;
#   set_real_ip_from 2405:8100::/32;
#   set_real_ip_from 2a06:98c0::/29;
#   set_real_ip_from 2c0f:f248::/32;
#   real_ip_header CF-Connecting-IP;

# Giới hạn riêng cho đăng ký cài đặt AI (đặt ở khối http { }):
#   limit_req_zone $binary_remote_addr zone=thaigit_install:10m rate=5r/h;

location = /v1/ai/install {
    limit_req zone=thaigit_install burst=3 nodelay;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    access_log off;
}

location ~ ^/(v1/|download/|healthz$) {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Ghi đè (không nối) — API chỉ tin header này khi đến từ 127.0.0.1.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    # SSE: không đệm, không cache, cho phép model trả lời chậm.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    client_max_body_size 256k;
    # Log truy cập chứa IP — tắt cho API.
    access_log off;
}

# Nên có ở khối server HTTPS: add_header Strict-Transport-Security "max-age=31536000" always;
